JWT_REFRESH_EXPIRES_IN=365d

# CORS
CLIENT_URL=http://localhost:3000

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Bcrypt
BCRYPT_SALT_ROUNDS=12
